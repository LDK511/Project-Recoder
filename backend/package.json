  "description": "데일리데스크 쇼핑몰 백엔드 (Express · PostgreSQL · Stripe)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:init": "node dist/db/init.js",
    "db:migrate": "node dist/db/init.js"
  },
  "keywords": [
